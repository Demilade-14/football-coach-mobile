# Mobile App Environment Variables
# Copy this file to .env and fill in your values
# API URL for mobile app to reach backend
# Use your LAN IP (from ipconfig), NOT localhost when testing on physical device
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.100:8081
# Firebase (get from Firebase Console → Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDdQ-WKhqmkQo5BJWs3QpMRwJfW9h4HK1Q
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=football-coach-mobile.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=football-coach-mobile
